					<dtsearch:MaxWordLength>64</dtsearch:MaxWordLength>
					<dtsearch:WeightChar>^</dtsearch:WeightChar>
					<dtsearch:CharRemap>
						<Remap-definitions>
							<Map SRC="*" DST="ᚠ"></Map>
							<Map SRC="?" DST="ᚡ"></Map>
							<Map SRC="&quot;" DST="ᚢ"></Map>
							<Map SRC="'" DST="ᚣ"></Map>
