					<dtsearch:ImproveRanking>false</dtsearch:ImproveRanking>
				</dtsearch:Maintenance>
				<dtsearch:Search>
					<dtsearch:SearchTimeout>120</dtsearch:SearchTimeout>
					<dtsearch:MaxDocsResults>1000</dtsearch:MaxDocsResults>
					<dtsearch:AutoStopLimit>10000000</dtsearch:AutoStopLimit>
					<dtsearch:DelayDocInfo>true</dtsearch:DelayDocInfo>
					<dtsearch:MaxWordsToRetrieve>2147483647</dtsearch:MaxWordsToRetrieve>
					<dtsearch:RestrictFileConditionRegExp>\s|\"|\'</dtsearch:RestrictFileConditionRegExp>
					<dtsearch:NumericFields>
						<dtsearch:NumericField>WordCount</dtsearch:NumericField>
						<dtsearch:NumericField>PageNo</dtsearch:NumericField>
					</dtsearch:NumericFields>
				</dtsearch:Search>
				<dtsearch:Highlight>
					<dtsearch:AuxDataInitLoadMode>HEADERS</dtsearch:AuxDataInitLoadMode>
					<dtsearch:AuxDataRequestLoadMode>HEADERS</dtsearch:AuxDataRequestLoadMode>
				</dtsearch:Highlight>
				<dtsearch:Prefix>
					<dtsearch:SearchField>DTSF</dtsearch:SearchField>
					<dtsearch:SearchStoredField>DTSSF</dtsearch:SearchStoredField>
				</dtsearch:Prefix>
			</dtsearch:SEConfig>
