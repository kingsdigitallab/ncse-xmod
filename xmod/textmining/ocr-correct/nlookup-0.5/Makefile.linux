# Makefile generated by Manolis

CPP=g++
OFLAG=-o 

.SUFFIXES: .o .cpp .c 

.cpp.o:
	$(CPP) $(CPPFLAGS) -c $<
.c.o:
	$(CPP) $(CPPFLAGS) -c $<

all: nlookup

clean: 
	rm -r *.o nlookup

dist:
	@tar zcvf nlookup.tar.gz Makefile.linux distfunctions.cpp distfunctions.h main.cpp matchfunctions.cpp matchfunctions.h statistics.cpp statistics.h term_stat.cpp term_stat.h corpus.cpp corpus.h timer.cpp timer.h version.txt lastnames.txt

nlookup: main.o distfunctions.o matchfunctions.o statistics.o term_stat.o corpus.o timer.o
	$(CPP) $(OFLAG) nlookup main.o distfunctions.o matchfunctions.o statistics.o term_stat.o corpus.o timer.o

distfunctions.o: distfunctions.cpp distfunctions.h

main.o: main.cpp matchfunctions.h timer.h

matchfunctions.o: matchfunctions.cpp matchfunctions.h distfunctions.h statistics.h corpus.h

statistics.o: statistics.cpp statistics.h term_stat.h corpus.h

term_stat.o: term_stat.cpp term_stat.h

corpus.o: corpus.cpp corpus.h

timer.o: timer.cpp timer.h
