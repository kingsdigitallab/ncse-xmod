# Makefile generated by Manolis

CPP=g++
OFLAG=-o 

.SUFFIXES: .o .cpp .c 

.cpp.o:
	$(CPP) $(CPPFLAGS) -c $<
.c.o:
	$(CPP) $(CPPFLAGS) -c $<

all: nlookup 

clean: 
	rm -r *.o nlookup

dist:
	@tar zcvf nlookup.tar.gz Makefile.linux distfunctions.cpp distfunctions.h main.cpp matchfunctions.cpp matchfunctions.h statistics.cpp statistics.h term_stat.cpp term_stat.h

nlookup: main.o distfunctions.o matchfunctions.o statistics.o term_stat.o
	$(CPP) $(OFLAG) nlookup main.o distfunctions.o matchfunctions.o statistics.o term_stat.o

distfunctions.o: distfunctions.cpp distfunctions.h

main.o: main.cpp matchfunctions.h

matchfunctions.o: matchfunctions.cpp matchfunctions.h distfunctions.h statistics.h

statistics.o: statistics.cpp statistics.h term_stat.h

term_stat.o: term_stat.cpp term_stat.h

