<?xml version="1.0" encoding="UTF-8"?>
<xs:schema targetNamespace="http://www.olivesoftware.com/Schemas/Locales" xmlns:locale="http://www.olivesoftware.com/Schemas/Locales" xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
	<xs:element name="Locale">
		<xs:annotation>
			<xs:documentation>Top element holding the list of text strings.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="locale:LocaleString" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="LocaleString">
		<xs:annotation>
			<xs:documentation>Single test string defined by the NAME attribute.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="xs:string">
					<xs:attribute name="NAME" type="xs:string" use="required">
						<xs:annotation>
							<xs:documentation>Unique ID of the text string. Must be upper case. See documentation for naming conventions.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>
</xs:schema>
