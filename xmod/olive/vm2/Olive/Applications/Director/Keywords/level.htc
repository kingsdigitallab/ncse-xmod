<public:property name="level" />
<public:property name="list" />
<public:property name="addButton" />
<public:property name="hasShortcuts" />
<public:property name="curLine" />
<public:property name="curIndex" />
<public:property name="levelNodes" />
<public:property name="nextLevel" />
<public:property name="prevLevel" />
<public:property name="readOnly" />

<public:method name="keyPressed" />
<public:method name="keyDown" />
<public:method name="initDiv" />
<public:method name="initLevel" />
<public:method name="setCurLine" />
<public:method name="getCurrentLine" />
<public:method name="enableNew" />
<public:method name="mouseOver" />
<public:method name="mouseOut" />
<public:method name="makeReadOnly" />

<public:attach event="onkeyup" for="element" onevent="keyPressed()" />
<public:attach event="onkeydown" for="element" onevent="keyDown()" />


<script language="JavaScript">
	var KEY_ENTER = 13;
	var KEY_RIGHT = 39;
	var KEY_LEFT  = 37;
	var KEY_DOWN  = 40;
	var KEY_UP    = 38;
	var KEY_PGDN  = 34;
	var KEY_PGUP  = 33;
	var KEY_HOME  = 36;
	var KEY_END   = 35;
	var KEY_ESCAPE = 27;
	
	var search = true;
	var nodeList;
	var index;		
	
	function initLevel()
	{		
		this.list = window.document.all["list"+this.id.substr(4)];
		this.addButton = window.document.all["new"+this.id.substr(4)];
		this.list.attachEvent("oncontextmenu",this.initPopup);
		this.list.attachEvent("onmouseover",this.mouseOver);
		this.list.attachEvent("onmouseout",this.mouseOut);
		this.list.attachEvent("ondblclick", openCurrentLine);
		this.list.attachEvent("onclick",openCurrentLine)
		if(this.readOnly)
		{
			this.makeReadOnly();
		}
		enableNew(false);			
	}
	function initDiv(parNode)
	{		
		this.list.innerHTML = parNode.transformNode(keysXsl.XMLDocument);		

		this.levelNodes = parNode.selectNodes(this.lnodename); 
		this.hasShortcuts = false;

		setCurLine(0);
		list.scrollTop = 0;
		var nl = this.nextLevel;
		while(nl)
		{
			nl.list.innerHTML = "";
			nl.enableNew(false);
			nl.value = "";
			nl = nl.nextLevel;
		}
	}
	
	function makeReadOnly()
	{
		enableNew(false);
		this.disabled = true;
		this.readOnly = true;
		this.list.style.backgroundColor = "WHITE"; 
	}
	
	function setCurLine(lineNo)
	{
		var newCur = this.list.all["lev_"+lineNo];
		if(!newCur)
			return;
		if(this.curLine && this.curLine.style)
			this.curLine.style.backgroundColor = ""; //window.bgOrgColor;
		this.curLine = newCur;
		this.curLine.style.backgroundColor = window.bgColor;
		this.curIndex = lineNo;
	}		

	function findIndex(text)
	{
		if(text == "") // Empty string - first position;
			return 0;

		var first = 0;
		var last = this.levelNodes.length;
		if(last < 2)
			return last;
		var curText = this.curLine.innerText;
		var cmpRes = compareStrs(text, curText);
		
		if(cmpRes == 0)
			return this.curIndex;
		else if(cmpRes > 0)
			first = this.curIndex;
		else
			last = this.curIndex;

		var mid, midText;
		var c = 0;
		
		while(last - first > 0)
		{
			c++;
			mid = Math.floor((first+last)/2);
			midText = this.levelNodes[mid].firstChild.text;
			cmpRes = compareStrs(text,midText)
			if(cmpRes == 0)
				return mid;
			else if(cmpRes < 0)
			{
				last = mid;					
			}					
			else if(cmpRes == 1)
			{
				if(first != mid)
					first = mid;						
				else 
					return mid + 1;
			}
		}
		return mid;
	}

	function keyPressed()
	{
		if(this.readOnly)
			return;
		if(!search)
			return;		
		if(!this.levelNodes || this.levelNodes.length == 0 && this.value.length == 0)
			return;

		var exectMatch;
		var sTop;

		var curText = this.value.toUpperCase();
		var newIndex = findIndex(curText);
						
		if(newIndex != this.curIndex)
		{
			sTop = window.offHight*(newIndex);
			setCurLine(newIndex);
		}		
		if(sTop<this.list.scrollTop || sTop > this.list.scrollTop+this.list.clientHeight)
		{
			this.list.scrollTop = sTop;
		}
		enableNew(this.levelNodes.length == 0 || (this.value.length>0 && this.value.toUpperCase() != curLine.innerText.toUpperCase()));
	}
	
	function compareStrs(s1Org,s2Org)
	{
		// returns: -2 if s1 is substr of s2
		// -1 if s1 < s2
		//  0 if s1 = s2
		//  1 if s1 > s2
		var s1 = s1Org.toUpperCase();
		var s2 = s2Org.toUpperCase();
		for(var i=0;i<s1.length;i++)		
			if(i>=s2.length || s1.charCodeAt(i)>s2.charCodeAt(i))
				return 1;
			else if(s1.charCodeAt(i)<s2.charCodeAt(i))
				return -1;
		if(s2.length == s1.length)
			return 0;
		else return -1;
	}

	function keyDown()
	{
		if(this.readOnly)
			return;
		search = false;
		var i = event.keyCode;					
		window.event.cancelBubble = true;

		switch (i)
		{
			case KEY_ESCAPE:
					if(this.level!="1")
					{			
						getLevel(parseInt(this.level,10)-1).focus();
						this.list.innerHTML = "";
					}
					this.value= "";
					enableNew(false);
					break;

			case KEY_ENTER:
					if(!this.curLine)
					{	// add as new item when list is empty
						var nLevel = parseInt(this.level,10);
						addAsNew(nLevel);
					}
					else
					{
						this.getCurrentLine(true,true,false);
						enableNew(false);
					}
					break;
			case KEY_RIGHT:
					enableNew(false);
					this.getCurrentLine(false,true,false);
					break;

			case KEY_HOME:
					moveByLines(-this.levelNodes.length);
					enableNew(false);
					break;

			case KEY_END:
					moveByLines(this.levelNodes.length);
					enableNew(false);
					break;

			case KEY_PGUP:
					moveByLines(-Math.floor(this.list.clientHeight/window.offHight));
					enableNew(false);
					break;

			case KEY_PGDN:
					moveByLines(Math.floor(this.list.clientHeight/window.offHight));
					enableNew(false);
					break;

			case KEY_UP:
					moveByLines(-1);
					enableNew(false);
					break;

			case KEY_DOWN:
					moveByLines(1);
					enableNew(false);
					break;

			default:
					search=true;
					window.event.cancelBubble = false;
					return true;
		}			
		return false;
	}
	
	function moveByLines(n)
	{		
		var newLine = this.curIndex + n;
		if(newLine < 0)
			newLine = 0;
		if(newLine >= this.levelNodes.length)
			newLine = this.levelNodes.length -1;
		var	moveLines = newLine - this.curIndex;
		if(moveLines == 0)
			return;
		setCurLine(newLine);
		this.list.scrollTop += moveLines * window.offHight;
		return;
	}
	
	function enableNew(flag)
	{
		if(flag)
			this.addButton.Enable();
		else
			this.addButton.Disable();
	}
		
	function openCurrentLine()
	{
		if(typeof(event.returnValue) != "undefined" && event.returnValue == false)
			return;
		if(this.readOnly)
			return;
		if(event.srcElement.tagName!="TD")
			return;
		enableNew(false);
		var newLine  = parseInt(event.srcElement.id.substr(4),10);
		setCurLine(newLine);
		if(event.type == "click")
			getCurrentLine(false,true,false);
		else // on double click
		{
			getCurrentLine(false,true,true);
			event.cancelBubble = true;
			event.returnValue = false;
		}
	}
	
	function getCurrentLine(add,open,path)
	{		
		if(this.readOnly)
			return;
		var intLevel = parseInt(this.level,10);
		var parWin = window.opener;
		this.value = this.curLine.innerText;
		var node = this.levelNodes[this.curIndex];
		if(open && (this.nextLevel != null))
		{
			if(node.childNodes.length > 1)
			{
				this.nextLevel.initDiv(node);			
				this.nextLevel.focus();
				this.nextLevel.value = "";
			}
			else this.nextLevel.list.innerHTML = "";
		}
		if(path)
		{			
			var keys="";
			while(intLevel)
			{
				keys = node.firstChild.text + SEPARATOR + keys;
				intLevel--;
				node = node.parentNode;
			}
			keys = keys.substr(0,keys.length-1);
			submitValue(keys);
		}
		if(add)
		{	
			submitValue(this.value);
		}
	}
	
	function initPopup()
	{	// show open|delete|modify 	
		if(this.readOnly)
			return;
		var elm = event.srcElement;
		if(elm.tagName!="TD")
			return;
		event.returnValue = false;				
		var newLine = parseInt(elm.id.substr(4),10)
		setCurLine(newLine);
		if(typeof(window.showPopup) !="undefined")
			window.showPopup(event.x,event.y,this,elm);
		return false;
	}
		
	function mouseOver()
	{
		if(event.srcElement.tagName=="TD");
		event.srcElement.style.color=window.bgOver;
	}
	function mouseOut()
	{
		if(event.srcElement.tagName=="TD");
		event.srcElement.style.color=window.orgColor;
	}
</script>
